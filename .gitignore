.terraform/
*.tfstate
*.tfstate.*

# Test artifacts
playwright-report/
test-results/

# Local database files
*.sqlite
*.sqlite3

# Python bytecode (scripts/)
__pycache__/
*.py[cod]

# Confluence sync previews (scripts/sync-confluence.py --dry-run)
.confluence-preview/
